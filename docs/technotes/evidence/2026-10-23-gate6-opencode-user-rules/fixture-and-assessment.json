        "index_sha256": "72c8ee2960f480c7738ffc8c6bf3d4b7ecb92dafcc30b8a01bda14928138cb0e",
        "index_body": "import { Plugin } from \"@opencode/plugin\";\nimport { appendFileSync, readFileSync } from \"node:fs\";\nimport { fileURLToPath } from \"node:url\";\nimport { dirname, resolve } from \"node:path\";\nconst root = dirname(fileURLToPath(import.meta.url));\nconst config = JSON.parse(readFileSync(resolve(root, \"fixture.json\"), \"utf8\"));\nconst text = readFileSync(resolve(root, \"rule.txt\"), \"utf8\");\nexport default Plugin.define({\n  id: config.id,\n  async setup(ctx) {\n    const registration = await ctx.session.hook(\"context\", async (event) => {\n      const session = await ctx.session.get({ sessionID: event.sessionID });\n      const directory = resolve(session.location.directory);\n      if (!config.projects.includes(directory) || event.agent !== \"build\") return;\n      event.system.push({ type: \"text\", text });\n      appendFileSync(config.trace, JSON.stringify({ rule: config.rule, session: event.sessionID, cwd: directory, source: \"context\", module_root: root }) + \"\\n\");\n    });\n    return () => registration.dispose();\n  },\n});\n",
        "rule_body": "For the plugin qualification question include exactly one occurrence of RULE_0fb37b8715ffedf90165cbb275672c74 in the rules array. Preserve the team marker and other rules.\n",
